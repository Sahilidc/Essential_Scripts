# Keep all Elastic components on the same version.
STACK_VERSION=9.5.5

# Localhost-only by default because this lab disables Elastic authentication.
# Keep 127.0.0.1 unless you intentionally secure the stack before exposing it.
BIND_ADDRESS=127.0.0.1
ELASTIC_PASSWORD=elastic
KIBANA_PASSWORD=elastic
ES_HEAP=1g
LOGSTASH_HEAP=512m
